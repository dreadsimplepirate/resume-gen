# Configuration for resume_gen.py
# Copy to .env and uncomment ONE provider block:  cp .env.example .env

# Option 1: OpenCode Go
OPENCODE_API_KEY="your-service-account-token"
OPENCODE_BASE_URL="opencode-go"
OPENCODE_MODEL="MiMo-V2.6-Pro"

# Option 2: Standard OpenAI
# OPENAI_API_KEY="sk-proj-..."
# OPENAI_MODEL="gpt-4o"

# Option 3: OpenRouter (auto-routes sk-or-* keys or OPENROUTER_API_KEY to https://openrouter.ai/api/v1)
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
